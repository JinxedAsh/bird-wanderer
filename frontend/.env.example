# Copy to .env for optional local overrides. Login needs no cloud API key.
APP_ORIGIN=http://localhost:3000
# Comma-separated extra origins, e.g. http://192.168.1.3:3000 for phone access.
ADDITIONAL_APP_ORIGINS=
# Optional exact HTTPS origin for an existing/named tunnel. dev:tunnel discovers quick tunnels automatically.
TUNNEL_ORIGIN=
# Optional cloudflared executable path if it is not on PATH.
CLOUDFLARED_PATH=
# Set to 0.0.0.0 to expose the frontend to devices on your local network.
FRONTEND_HOST=127.0.0.1
PORT=3001
HOST=127.0.0.1
# Server-only eBird key from https://ebird.org/api/keygen. Never use VITE_ for secrets.
EBIRD_API_KEY=
# Default discovery region: Delhi. Use a valid eBird region code.
EBIRD_REGION=IN-DL
# Delhi adds Gautam Buddha Nagar (Noida) by default for Okhla coverage.
# Set empty to use only the primary region; otherwise comma-separated, up to three.
# EBIRD_ADDITIONAL_REGIONS=IN-UP-GB
# DATABASE_PATH defaults to frontend/data/bird-wanderer.sqlite
# Production requires NODE_ENV=production and an HTTPS APP_ORIGIN.
# Deploy with persistent disk for the database, outside the public directory.

# MEDIA_PATH defaults to frontend/data/media; private disk, outside the public directory.

# Optional Firebase push. Leave unset for in-app alerts without device push.
# Service-account JSON must live OUTSIDE this repository. Never use a VITE_ variable for it.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Public Firebase Web app fields as one JSON line: apiKey,authDomain,projectId,messagingSenderId,appId.
FIREBASE_WEB_CONFIG=
FIREBASE_VAPID_PUBLIC_KEY=

# Optional password recovery. Leave ALL SMTP fields empty to keep it unavailable.
# Credentials are server-only; never prefix with VITE_. Requires an existing mail provider.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional exact allowed origin for emailed links; defaults to APP_ORIGIN.
# Must also be APP_ORIGIN or listed in ADDITIONAL_APP_ORIGINS/current TUNNEL_ORIGIN.
RECOVERY_ORIGIN=
