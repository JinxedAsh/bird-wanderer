# Copy to .env for optional local overrides. Login needs no cloud API key.
APP_ORIGIN=http://localhost:3000
# Comma-separated extra origins, e.g. http://192.168.1.3:3000 for phone access.
ADDITIONAL_APP_ORIGINS=
# Optional exact HTTPS origin for an existing/named tunnel. dev:tunnel discovers quick tunnels automatically.
TUNNEL_ORIGIN=
# Optional cloudflared executable path if it is not on PATH.
CLOUDFLARED_PATH=
# Set to 0.0.0.0 to expose the frontend to devices on your local network.
FRONTEND_HOST=127.0.0.1
PORT=3001
HOST=127.0.0.1
# Server-only eBird key from https://ebird.org/api/keygen. Never use VITE_ for secrets.
EBIRD_API_KEY=
# Default discovery region: Delhi. Use a valid eBird region code.
EBIRD_REGION=IN-DL
# DATABASE_PATH defaults to frontend/data/bird-wanderer.sqlite
# Production requires NODE_ENV=production and an HTTPS APP_ORIGIN.
# Deploy with persistent disk for the database, outside the public directory.
